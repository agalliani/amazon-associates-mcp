# Amazon Associates MCP — credentials
# Copy to .env and fill in your details

# Amazon Associates account email
AMAZON_EMAIL=your-email@example.com

# Amazon password (used as fallback for automated re-login)
AMAZON_PASSWORD=your-password

# Default marketplace when none is specified in a tool call
# Options: it, com, de, fr, es, co.uk, co.jp, ca, com.au, ...
AMAZON_MARKETPLACE=it

# All marketplaces you are enrolled in (used by: node setup.mjs --all)
AMAZON_MARKETPLACES=it,com,de,fr,es
